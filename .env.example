# ---------------------------------------------------------------------------
# rag-support environment configuration
# Copy this file to .env and fill in the values you need. Every setting has
# a safe default in src/rag_support/config.py, so the app runs fully offline
# with zero configuration -- these are the knobs for production use.
# ---------------------------------------------------------------------------

# --- Database -----------------------------------------------------------
# Full SQLAlchemy URL. The docker-compose service already sets this for you.
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag_support

# --- Provider selection ---------------------------------------------------
# Each is resolved independently and falls back automatically:
#   openai  -> requires OPENAI_API_KEY, best quality
#   local   -> HuggingFace models downloaded on first use, no API cost
#   offline -> pure-Python fallback (hashing embedder / extractive answerer),
#              zero downloads, used automatically when nothing else is
#              configured or reachable (e.g. no network egress).
EMBEDDING_PROVIDER=auto      # auto | openai | local | offline
LLM_PROVIDER=auto            # auto | openai | local | offline

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_LLM_MODEL=google/flan-t5-base

# --- Data source ------------------------------------------------------
# hf     -> pull the Bitext customer-support dataset live from Hugging Face
# sample -> use the bundled, offline sample knowledge base (default)
DATA_SOURCE=sample

# --- Retrieval / chunking -------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4

# --- API ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
